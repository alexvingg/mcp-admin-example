PORT=3001

# Auth0 — preencha com os valores do seu tenant
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://admin-api.local
AUTH0_ISSUER_BASE_URL=https://your-tenant.us.auth0.com/

# Database (default: container 'db' da rede do compose)
DATABASE_URL=postgresql://admin:admin@db:5432/admindb?schema=public

# CORS — origem do frontend
CORS_ORIGIN=http://localhost:5173

# Pre-shared key usado pela Auth0 Action ao chamar POST /internal/permissions
# Gere uma string aleatória forte: openssl rand -hex 32
INTERNAL_PSK=replace-me-with-strong-random-string

# sub Auth0 do user@demo.local — usado no seed inicial de entitlements.
# Pegue esse valor após criar o user no Auth0 dashboard (User Management → Users → clica no email).
# Formato típico: auth0|abcdef1234567890. Se deixar vazio, o seed é pulado.
DEMO_ENTITLED_USER_SUB=auth0|your-user-sub-here
