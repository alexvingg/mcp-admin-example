# Auth0 — preencha com os valores do app Native que você criar
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://admin-api.local

# Client ID da application Native (admin-mcp) — diferente da SPA admin-web
MCP_CLIENT_ID=xxxxxxxxxxxx

# URL do admin-api (rodando em docker compose)
API_BASE_URL=http://localhost:3001

# Porta usada pelo http server local que recebe o callback do Auth0 no fluxo PKCE.
# DEVE estar listada nos Allowed Callback URLs do Auth0 Native app:
#   http://localhost:8765/callback
PKCE_CALLBACK_PORT=8765
