.env
.env.local
.env.*.local
!.env.example

# ── Logs ─────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── OS ───────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo

# ── Editors / IDEs ───────────────────────────
.vscode/
.idea/
*.iml

# ── Coverage / cache ─────────────────────────
coverage/
.cache/
.eslintcache
.parcel-cache/
.turbo/
.vite/

