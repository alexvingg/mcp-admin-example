# ── Dependencies ─────────────────────────────
node_modules/
.npm/
.pnp.*
.yarn/

# ── Builds ───────────────────────────────────
dist/
build/
.next/
out/
*.tsbuildinfo

# ── Env files (SECRETS — fica local) ─────────
