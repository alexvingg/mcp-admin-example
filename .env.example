# ─── Root .env.example ───────────────────────────────────────────────
# Esse arquivo é só REFERÊNCIA. Cada app tem seu próprio .env:
#   apps/admin-api/.env   ← copie de apps/admin-api/.env.example
#   apps/admin-web/.env   ← copie de apps/admin-web/.env.example
#   apps/admin-mcp/.env   ← copie de apps/admin-mcp/.env.example
#
# Setup inicial: `npm run setup` cria os 3 .env automaticamente a partir
# dos respectivos .env.example. Depois edite com valores reais do seu tenant.

# Valores compartilhados (referência apenas — não são lidos diretamente):
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://admin-api.local

# Para subir o Docker Compose com Postgres customizado:
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_DB=admindb
